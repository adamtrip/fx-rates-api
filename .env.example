# Passwords must not contain semicolons, which delimit connection string fields.
# For IDE runs, appsettings.Development.json expects the PostgreSQL password "fxrates-dev".
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-another-long-random-password
API_PORT=5080
RABBITMQ_MANAGEMENT_PORT=15672
# Set Fake explicitly for an offline demo. No automatic fallback to fake prices.
EXCHANGE_PROVIDER_MODE=AlphaVantage
ALPHA_VANTAGE_API_KEY=
PROVIDER_TIMEOUT_SECONDS=10
# RabbitMq publishes rate.created events to the broker; Logging only writes them to the API log.
MESSAGING_MODE=RabbitMq
RATE_LIMIT_PER_MINUTE=60
